<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= communityUser.username %>'s Pantry</title>
</head>
<body>
  <%- include('../partials/_navbar.ejs') %>

  <h1><%= communityUser.username %>'s Pantry</h1>
  <p>Look currently this User have stored:</p>

  <ul>
    <% if (communityUser.pantry && communityUser.pantry.length > 0) { %>
      <% communityUser.pantry.forEach((food) => { %>
        <li>
          <%= food.name %>
        </li>
      <% }) %>
    <% } else { %>
      <li>This pantry is currently empty.</li>
    <% } %>
  </ul>

  <br />
  <a href="/users">Back to Community</a>
</body>
</html>
