<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>Editing <%= food.name %></title>
  </head>
  <body>
    <div class="edit-body">
      <h1>Editing: <%= food.name %></h1>

      <!-- RESTful PUT method override targeting the specific subdocument -->
      <form action="/users/<%= user._id %>/foods/<%= food._id %>?_method=PUT" method="POST">
        
        <label for="name">Food Name:</label>
        <input
          type="text"
          name="name"
          id="name"
          value="<%= food.name %>"
          required
        />

        <button type="submit">Update Item</button>
      </form>

      <br />
      <a href="/users/<%= user._id %>/foods/<%= food._id %>">Back to Show Page</a>

      <br />
      <a href="/users/<%= user._id %>/foods">Back to Pantry</a>
    </div>
  </body>
</html>