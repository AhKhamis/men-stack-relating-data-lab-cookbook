<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Pantry</title>
  </head>
  <body>
    <h1>Welcome to my Pantry</h1>

<ul>
    <% foods.forEach((food) => { %>
      <li>
        <a href="/users/<%= user._id %>/foods/<%= food._id %>">
          <%= food.name %>
        </a>
      </li>
    <% }) %>
  </ul>

    <a href="/users/<%= user._id %>/foods/new">Add New Item</a>

  </body>
</html>